# Django application/worker environment only.
# Infrastructure bootstrap/admin/migration/monitoring secrets are intentionally
# separate: see deploy/infra.env.example. Do not merge those secrets into this
# file in production.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=replace-with-a-random-production-secret-key-at-least-50-characters-long
TOTP_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL long-lived runtime role. It is NOT database/schema owner and must
# not receive migration/admin credentials. Production traffic uses PgBouncer.
POSTGRES_DB=bz_get
POSTGRES_USER=bz_get_app
POSTGRES_PASSWORD=replace-with-runtime-secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MinIO application identity only. Root/bootstrap credentials live in the
# infrastructure secret set. The app policy can mutate working, but cannot
# delete/bypass retention in originals. Presigned file URLs expire quickly.
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_ACCESS_KEY=bz_get_app
MINIO_SECRET_KEY=replace-with-minio-app-secret
MINIO_BUCKET_ORIGINALS=bz-get-originals
MINIO_BUCKET_WORKING=bz-get-working
MINIO_PRESIGNED_URL_TTL_SECONDS=300

# Business metrics are an internal monitoring surface. Production requires a
# random bearer token of at least 32 characters; see deploy/monitoring/.
BUSINESS_METRICS_TOKEN=replace-with-random-monitoring-bearer-token-at-least-32-characters

# Redis / Celery. visibility timeout must exceed OCR hard timeout.
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_REDIS_VISIBILITY_TIMEOUT=900

# ClamAV
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30

# IAM brute-force protection.
IAM_IP_LOCKOUT_MAX_ATTEMPTS=20

# Production shared limiter cache; separate Redis DB from the broker.
CACHE_URL=redis://localhost:6379/2
TRUSTED_PROXIES=
TRUST_PROXY_HTTPS=0

# Web Smart Search has its own authenticated per-user fixed-window budget.
WEB_SEARCH_RATE_LIMIT=60
WEB_SEARCH_RATE_WINDOW_SECONDS=60

# Unified intake/OCR limits.
UPLOAD_MAX_BYTES=157286400
OCR_MAX_PAGES=1000
OCR_PROCESS_TIMEOUT=60
OCR_MAX_DIMENSION=3000
OOXML_MAX_ENTRIES=10000
OOXML_MAX_MEMBER_BYTES=134217728
OOXML_MAX_UNCOMPRESSED_BYTES=536870912
OOXML_MAX_COMPRESSION_RATIO=100
OOXML_COMPRESSION_RATIO_MIN_BYTES=1048576

# veraPDF Greenfield runtime used for mandatory PDF/A-2b conformance checks.
VERAPDF_EXECUTABLE=verapdf
VERAPDF_TIMEOUT_SECONDS=60
