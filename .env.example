# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=replace-with-a-random-production-secret-key-at-least-50-characters-long
# Шифрование секретов TOTP в БД (apps/iam/totp_crypto.py) — отдельный ключ
# от SECRET_KEY. Сгенерировать: python -c "from cryptography.fernet import
# Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL.
# Локальная разработка: одиночный Postgres на localhost:5432.
# Этап 4 / HA production: приложение НЕ подключается напрямую к db1/db2/db3.
# На каждом app-узле оно идёт через локальный PgBouncer -> HAProxy -> Patroni
# primary (deploy/ha/): POSTGRES_HOST=127.0.0.1, POSTGRES_PORT=6432.
POSTGRES_DB=bz_get
POSTGRES_USER=bz_get
POSTGRES_PASSWORD=bz_get
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MinIO (S3-совместимое распределённое хранилище по ТЗ 4.9, используется в prod-настройках).
# Два бакета с разными политиками — см. STACK.md → «Разделение политик хранения»:
# originals — Object Locking/WORM, не перезаписывается; working — обычный, заменяемый.
# Локальная разработка: http://localhost:9000.
# Этап 4 / DR production: MINIO_ENDPOINT_URL должен быть стабильным DNS/LB
# endpoint, который операционно переключается между active/passive MinIO sites
# без смены имён бакетов.
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_ACCESS_KEY=bz_get
MINIO_SECRET_KEY=bz_get_secret
MINIO_BUCKET_ORIGINALS=bz-get-originals
MINIO_BUCKET_WORKING=bz-get-working

# Redis / Celery. visibility timeout должен быть выше hard timeout самой
# длинной OCR-задачи (600 с), иначе здоровая задача может быть доставлена
# повторно до завершения. Stage 4 acceptance baseline — 900 с.
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_REDIS_VISIBILITY_TIMEOUT=900

# Grafana (дашборды метрик по ТЗ 4.8, локальная разработка)
GRAFANA_ADMIN_PASSWORD=bz_get

# ClamAV (антивирусная проверка загружаемых файлов, ТЗ 4.7, Этап 3) —
# тот же контейнер, что и в docker-compose.yml с Этапа 1.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30

# Production shared limiter cache; separate Redis DB from the broker.
CACHE_URL=redis://localhost:6379/2
# Comma-separated trusted proxy CIDRs; empty trusts no headers.
TRUSTED_PROXIES=
# Only enable behind an edge overwriting X-Forwarded-Proto with direct ingress blocked.
TRUST_PROXY_HTTPS=0
OCR_MAX_PAGES=1000
OCR_PROCESS_TIMEOUT=60
OCR_MAX_DIMENSION=3000
