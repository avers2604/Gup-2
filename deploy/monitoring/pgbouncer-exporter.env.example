# Copy to /etc/bz-get/pgbouncer-exporter.env, chmod 0600, owned by root.
# The exporter connects only to the local PgBouncer admin database.
PGBOUNCER_EXPORTER_CONNECTION_STRING=postgresql://pgbouncer_exporter:CHANGE_ME_PASSWORD@127.0.0.1:6432/pgbouncer?sslmode=disable
PGBOUNCER_EXPORTER_WEB_LISTEN_ADDRESS=CHANGE_ME_MONITORING_IP:9127
