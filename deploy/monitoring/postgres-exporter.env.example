# Copy to /etc/bz-get/postgres-exporter.env, chmod 0600, owned by root.
# One exporter runs on each DB node and connects to its local PostgreSQL.
# Replace the password before use; do not commit real credentials.
DATA_SOURCE_NAME=postgresql://postgres_exporter:CHANGE_ME_PASSWORD@127.0.0.1:5432/bz_get?sslmode=verify-full&sslrootcert=/etc/bz-get/pki/ca.crt&sslcert=/etc/bz-get/pki/postgres-exporter.crt&sslkey=/etc/bz-get/pki/postgres-exporter.key
POSTGRES_EXPORTER_WEB_LISTEN_ADDRESS=CHANGE_ME_MONITORING_IP:9187
POSTGRES_EXPORTER_EXTEND_QUERY_PATH=/etc/bz-get/monitoring/postgres-queries.yml
