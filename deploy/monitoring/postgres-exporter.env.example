# Copy to /etc/bz-get/postgres-exporter.env.
# One exporter runs on each DB node under OS user `postgres_exporter` and
# connects to local PostgreSQL through the Unix socket with peer auth.
DATA_SOURCE_NAME=postgresql:///bz_get?host=/var/run/postgresql&user=postgres_exporter
POSTGRES_EXPORTER_WEB_LISTEN_ADDRESS=CHANGE_ME_MONITORING_IP:9187
