# Copy to /etc/bz-get/alertmanager/alertmanager.env on each Alertmanager node.
# Node-local advertise address must be an IP:port reachable by the peer.
ALERTMANAGER_LISTEN_ADDRESS=0.0.0.0:9093
ALERTMANAGER_CLUSTER_LISTEN_ADDRESS=0.0.0.0:9094
ALERTMANAGER_CLUSTER_ADVERTISE_ADDRESS=CHANGE_ME_NODE_IP:9094
ALERTMANAGER_PEER_1=CHANGE_ME_ALERTMANAGER1_IP:9094
ALERTMANAGER_PEER_2=CHANGE_ME_ALERTMANAGER2_IP:9094
