# Stage 4 production reference. Replace hostnames with addresses from the
# approved monitoring network. Do not expose exporter ports to user networks.
global:
  scrape_interval: 15s
  scrape_timeout: 10s
  evaluation_interval: 15s
  external_labels:
    system: bz-get
    environment: production

rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager1:9093
            - alertmanager2:9093

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["127.0.0.1:9090"]

  - job_name: alertmanager
    static_configs:
      - targets:
          - alertmanager1:9093
          - alertmanager2:9093
        labels:
          cluster: bz-get

  - job_name: patroni
    metrics_path: /metrics
    static_configs:
      - targets:
          - db1:8008
          - db2:8008
          - db3:8008
        labels:
          cluster: bz-get

  - job_name: postgres_exporter
    static_configs:
      - targets:
          - db1:9187
          - db2:9187
          - db3:9187
        labels:
          cluster: bz-get

  - job_name: pgbouncer_exporter
    static_configs:
      - targets:
          - app1:9127
          - app2:9127
        labels:
          cluster: bz-get

  - job_name: pgbackrest
    scrape_interval: 60s
    scrape_timeout: 30s
    static_configs:
      - targets:
          - backup1:9854
        labels:
          cluster: bz-get

  # Business indicators from Django. Counters are persisted in PostgreSQL,
  # therefore both app instances expose the same values; dashboards use max()
  # across instances rather than sum() to avoid double counting.
  - job_name: bz_get_business
    metrics_path: /metrics/business/
    static_configs:
      - targets:
          - app1:8000
          - app2:8000
        labels:
          cluster: bz-get
