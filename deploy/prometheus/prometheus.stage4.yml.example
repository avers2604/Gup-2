# Stage 4 production reference. Replace hostnames with addresses from the
# approved monitoring network. Do not expose exporter ports to user networks.
global:
  scrape_interval: 15s
  scrape_timeout: 10s
  evaluation_interval: 15s
  external_labels:
    system: bz-get
    environment: production

rule_files:
  - /etc/prometheus/rules/*.yml

# Send every alert to both Alertmanager peers directly. Do not put a single
# load balancer between Prometheus and the Alertmanager HA cluster.
alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager1:9093
            - alertmanager2:9093

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["127.0.0.1:9090"]

  - job_name: alertmanager
    static_configs:
      - targets:
          - alertmanager1:9093
          - alertmanager2:9093
        labels:
          cluster: bz-get

  # Patroni 4.1.x exposes native Prometheus metrics at GET /metrics.
  - job_name: patroni
    metrics_path: /metrics
    static_configs:
      - targets:
          - db1:8008
          - db2:8008
          - db3:8008
        labels:
          cluster: bz-get

  # One postgres_exporter per DB node, connected to local PostgreSQL using the
  # read-only postgres_exporter role from deploy/monitoring/.
  - job_name: postgres_exporter
    static_configs:
      - targets:
          - db1:9187
          - db2:9187
          - db3:9187
        labels:
          cluster: bz-get

  # One PgBouncer exporter per application node. Add/remove app nodes here or
  # migrate this list to file_sd/service discovery when the address plan is set.
  - job_name: pgbouncer_exporter
    static_configs:
      - targets:
          - app1:9127
          - app2:9127
        labels:
          cluster: bz-get

  # Run the small read-only exporter on the host that can read the pgBackRest
  # repository. It executes only `pgbackrest info --output=json` and caches it.
  - job_name: pgbackrest
    scrape_interval: 60s
    scrape_timeout: 30s
    static_configs:
      - targets:
          - backup1:9854
        labels:
          cluster: bz-get
