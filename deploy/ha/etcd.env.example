# etcd v3 reference environment file for ONE node.
# Copy to /etc/default/etcd (or an EnvironmentFile consumed by systemd) and
# replace all CHANGE_ME values. Use the same INITIAL_CLUSTER/TOKEN on all
# three members; NAME, listen and advertise addresses are node-local.

ETCD_NAME=CHANGE_ME_ETCD_NODE_NAME
ETCD_DATA_DIR=/var/lib/etcd
ETCD_INITIAL_CLUSTER_TOKEN=bz-get-ha-v1
ETCD_INITIAL_CLUSTER_STATE=new
ETCD_INITIAL_CLUSTER="etcd1=https://CHANGE_ME_ETCD1_IP:2380,etcd2=https://CHANGE_ME_ETCD2_IP:2380,etcd3=https://CHANGE_ME_ETCD3_IP:2380"

ETCD_LISTEN_CLIENT_URLS=https://CHANGE_ME_THIS_NODE_IP:2379,https://127.0.0.1:2379
ETCD_ADVERTISE_CLIENT_URLS=https://CHANGE_ME_THIS_NODE_IP:2379
ETCD_LISTEN_PEER_URLS=https://CHANGE_ME_THIS_NODE_IP:2380
ETCD_INITIAL_ADVERTISE_PEER_URLS=https://CHANGE_ME_THIS_NODE_IP:2380

# TLS is mandatory in the production reference topology. Generate a CA plus
# node certificates whose SANs contain the private IP/DNS names used above.
ETCD_CLIENT_CERT_AUTH=true
ETCD_TRUSTED_CA_FILE=/etc/bz-get/pki/ca.crt
ETCD_CERT_FILE=/etc/bz-get/pki/etcd.crt
ETCD_KEY_FILE=/etc/bz-get/pki/etcd.key
ETCD_PEER_CLIENT_CERT_AUTH=true
ETCD_PEER_TRUSTED_CA_FILE=/etc/bz-get/pki/ca.crt
ETCD_PEER_CERT_FILE=/etc/bz-get/pki/etcd-peer.crt
ETCD_PEER_KEY_FILE=/etc/bz-get/pki/etcd-peer.key
