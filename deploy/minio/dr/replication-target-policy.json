{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadReplicationBucketConfiguration",
      "Effect": "Allow",
      "Action": [
        "s3:GetReplicationConfiguration",
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:ListBucketMultipartUploads",
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetEncryptionConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::bz-get-originals",
        "arn:aws:s3:::bz-get-working"
      ]
    },
    {
      "Sid": "SynchronizeOriginalsBucketLockConfiguration",
      "Effect": "Allow",
      "Action": [
        "s3:PutBucketObjectLockConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::bz-get-originals"
      ]
    },
    {
      "Sid": "ReceiveReplicatedObjectVersions",
      "Effect": "Allow",
      "Action": [
        "s3:ReplicateTags",
        "s3:AbortMultipartUpload",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetObjectVersionTagging",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:ReplicateObject",
        "s3:ReplicateDelete"
      ],
      "Resource": [
        "arn:aws:s3:::bz-get-originals/*",
        "arn:aws:s3:::bz-get-working/*"
      ]
    },
    {
      "Sid": "ReceiveOriginalsObjectLockMetadata",
      "Effect": "Allow",
      "Action": [
        "s3:PutObjectRetention",
        "s3:PutObjectLegalHold"
      ],
      "Resource": [
        "arn:aws:s3:::bz-get-originals/*"
      ]
    }
  ]
}
