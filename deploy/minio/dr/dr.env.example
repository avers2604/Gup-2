# MinIO DR active-passive bucket replication.
# Copy to a root-readable file outside the repository, chmod 0600.
# Never commit real access/secret keys.

MINIO_SOURCE_URL=https://minio-primary.example.internal
MINIO_TARGET_URL=https://minio-dr.example.internal

# Source user: replication-admin policy from replication-admin-policy.json.
MINIO_SOURCE_ACCESS_KEY=CHANGE_ME_REPLICATION_ADMIN_ACCESS_KEY
MINIO_SOURCE_SECRET_KEY=CHANGE_ME_REPLICATION_ADMIN_SECRET_KEY

# Target user: replication-target policy from replication-target-policy.json.
MINIO_TARGET_ACCESS_KEY=CHANGE_ME_REPLICATION_TARGET_ACCESS_KEY
MINIO_TARGET_SECRET_KEY=CHANGE_ME_REPLICATION_TARGET_SECRET_KEY

MINIO_BUCKET_ORIGINALS=bz-get-originals
MINIO_BUCKET_WORKING=bz-get-working

# Optional CA bundle for private PKI. Leave empty only if system trust already
# contains the CA. Do not use --insecure in production.
MINIO_CA_FILE=/etc/bz-get/pki/ca.crt

# Override if mc is installed elsewhere.
MC_BIN=/usr/local/bin/mc
