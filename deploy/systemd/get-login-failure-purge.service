[Unit]
Description=BZ GET purge expired IAM login failure projection
After=network-online.target

[Service]
Type=oneshot
User=get
Group=get
WorkingDirectory=/opt/get
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
EnvironmentFile=/opt/get/.env
ExecStart=/opt/get/venv/bin/python manage.py purge_login_failures --older-than-hours 24
