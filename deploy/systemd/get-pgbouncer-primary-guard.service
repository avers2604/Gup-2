[Unit]
Description=BZ GET PgBouncer primary routing guard
After=network-online.target haproxy.service pgbouncer.service
Wants=network-online.target
Requires=haproxy.service pgbouncer.service

[Service]
Type=simple
# Same UID as PgBouncer: the built-in console user "pgbouncer" is
# passwordless only on the local Unix socket for the owning Unix account.
User=pgbouncer
Group=pgbouncer
# HAProxy creates /run/haproxy/guard.sock as group pgbouncer, level=user.
# No supplementary membership in the HAProxy/admin group is required.
ExecStart=/usr/bin/python3 /usr/local/libexec/bz-get/pgbouncer_primary_guard.py
Restart=always
RestartSec=2
SyslogIdentifier=bz-get-pgbouncer-primary-guard
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
