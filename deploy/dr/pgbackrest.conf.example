# pgBackRest reference configuration for PostgreSQL/Patroni nodes.
# Copy to /etc/pgbackrest/pgbackrest.conf. Do not commit production secrets.
# The repository host must be a separate failure domain from the DB nodes.

# --- Вариант A: этот файл на УЗЛЕ БД (db1/db2/db3) ---
# Локальный кластер объявляется без pgN-host.
[bz-get]
pg1-path=/var/lib/postgresql/18/bz-get

# --- Вариант B: этот файл на ОПЕРАЦИОННОМ/BASTION хосте ---
# Именно оттуда deploy/acceptance/acceptance-cycle.sh запускает `pgbackrest
# check` и `pgbackrest info`. Такая конфигурация ОБЯЗАНА перечислять ВСЕ узлы
# кластера: после switchover/failover primary оказывается на другом узле, и
# объявление единственного pg1 роняет проверку с
# "ERROR: [027]: primary database not found".
#
# Воспроизведено на стенде-репетиции (docs/STAGE4_LAB_REHEARSAL.md, Ф-5): после
# переключения лидера preflight приёмки перестал проходить, пока не были
# объявлены pg2/pg3. До исправления harness сообщал об этом ТОЛЬКО кодом
# возврата 27, без единой строки причины.
#
# [bz-get]
# pg1-path=/var/lib/postgresql/18/bz-get
# pg1-host=CHANGE_ME_DB1_HOST
# pg1-port=5432
# pg2-path=/var/lib/postgresql/18/bz-get
# pg2-host=CHANGE_ME_DB2_HOST
# pg2-port=5432
# pg3-path=/var/lib/postgresql/18/bz-get
# pg3-host=CHANGE_ME_DB3_HOST
# pg3-port=5432

[global]
# Dedicated backup host. Replace with the real backup repository endpoint.
repo1-host=CHANGE_ME_BACKUP_HOST
repo1-host-user=pgbackrest
repo1-path=/var/lib/pgbackrest

# Encrypt backup contents at rest. Store the real passphrase outside Git.
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=CHANGE_ME_BACKUP_CIPHER_PASSPHRASE

# Bootstrap retention for integration/acceptance testing, NOT an approved
# production retention SLA. Reconfirm after the customer approves RPO/RTO and
# backup retention requirements.
repo1-retention-full=4
repo1-retention-full-type=count
repo1-retention-diff=14
repo1-retention-history=365

start-fast=y
archive-async=y
spool-path=/var/spool/pgbackrest
process-max=4
compress-type=zst
repo1-bundle=y
repo1-block=y

log-level-console=info
log-level-file=detail
log-path=/var/log/pgbackrest

[global:archive-push]
process-max=2

[global:archive-get]
process-max=2
