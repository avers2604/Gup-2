# Copy outside the repository, e.g. /etc/bz-get/dr/drill.env, and edit.
# No production credentials belong in Git.
DRILL_ID=CHANGE_ME_YYYYMMDD_01
DRILL_EVIDENCE_ROOT=/var/lib/bz-get/drills

PATRONI_CONFIG=/etc/patroni/patroni.yml
PATRONI_SCOPE=bz-get
PGBACKREST_BIN=pgbackrest

# MinIO DR helper reads its own credentials from this root-readable file.
MINIO_DR_ENV=/etc/bz-get/minio-dr.env

# One reachable Alertmanager API endpoint is enough for evidence collection.
# HA delivery itself is checked separately against both peers.
ALERTMANAGER_URL=http://CHANGE_ME_ALERTMANAGER_MONITORING_IP:9093

# Fill during/after the exercise to calculate observed bounds.
# ISO-8601 UTC only, e.g. 2026-09-10T19:30:00Z.
DRILL_INCIDENT_UTC=
DRILL_LAST_DURABLE_UTC=
DRILL_SERVICE_RESTORED_UTC=

# Optional free-text identifiers copied into the final evidence summary.
DRILL_CHANGE_ID=CHANGE_ME
DRILL_OPERATOR=CHANGE_ME
