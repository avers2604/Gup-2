# Stage 4 HA/DR acceptance inventory.
# Copy to /etc/bz-get/stage4-acceptance.env on the operations/bastion host.
# Keep real addresses/credentials outside Git and make the file root-readable.

# Patroni/DB
PATRONI_CONFIG=/etc/patroni/patroni.yml
PATRONI_SCOPE=bz-get
EXPECTED_DB_MEMBERS=db1,db2,db3
MAX_REPLICA_LAG_BYTES=1048576

# etcd v3 TLS endpoints. etcdctl reads these files locally on the ops host.
ETCD_ENDPOINTS=https://CHANGE_ME_ETCD1:2379,https://CHANGE_ME_ETCD2:2379,https://CHANGE_ME_ETCD3:2379
ETCD_CACERT=/etc/bz-get/pki/ca.crt
ETCD_CERT=/etc/bz-get/pki/ops-etcd.crt
ETCD_KEY=/etc/bz-get/pki/ops-etcd.key

# PostgreSQL backup repository
PGBACKREST_BIN=pgbackrest
PGBACKREST_STANZA=bz-get
MAX_BACKUP_AGE_SECONDS=90000

# Existing MinIO DR helper from deploy/minio/dr/.
MINIO_DR_ENV=/etc/bz-get/minio-dr.env

# Alertmanager HA endpoints. No credentials are committed here.
ALERTMANAGER_URLS=http://CHANGE_ME_AM1:9093,http://CHANGE_ME_AM2:9093

# Stable application endpoint that must survive DB/MinIO failover.
APP_HEALTH_URL=https://CHANGE_ME_APP/health/
APP_HEALTH_EXPECT_REGEX='^(ok|healthy|ready)$'

# Stage 4 extended acceptance. The authoritative baseline lives in the
# version-controlled acceptance-policy.json:
#   >= 10,000 documents, <= 3,600 seconds, >= 500 MinIO object versions.
# These host-local values may be made stricter without approval. Weakening any
# of them requires the complete waiver metadata below and produces
# PASS_WITH_WAIVER, never an unqualified PASS.
ACCEPTANCE_MANAGE_COMMAND='.venv/bin/python manage.py'
SEARCH_REINDEX_DOCUMENTS=10000
SEARCH_REINDEX_MAX_SECONDS=3600
SEARCH_REINDEX_BATCH_SIZE=1000
MINIO_HASH_SAMPLE_SIZE=500

# Destructive guard for the timed cold rebuild. Leave NO on ordinary production
# hosts. Change to YES only for the approved acceptance window/change ticket.
# The management command additionally requires the explicit confirmation phrase
# passed by extended-checks.sh, so this flag alone is not sufficient.
ACCEPTANCE_ALLOW_DESTRUCTIVE_REINDEX=NO

# Optional deterministic MinIO sample seed. If empty/unset, RUN_ID is used and
# written into evidence. Reusing the same seed over the same version population
# yields the same sample.
MINIO_HASH_SAMPLE_SEED=

# Celery/Redis kill -9 drill. Run both worker and redis scenarios.
QUEUE_DRILL_TASKS=20
QUEUE_DRILL_SLEEP_SECONDS=20

# Required only when a baseline criterion is weakened. The ID must reference
# the actual customer/operations approval; approver and reason are preserved in
# acceptance-policy.json evidence and RESULT.md.
ACCEPTANCE_WAIVER_ID=
ACCEPTANCE_WAIVER_APPROVER=
ACCEPTANCE_WAIVER_REASON=

# Evidence directory. Must be writable by the acceptance operator.
ACCEPTANCE_EVIDENCE_ROOT=/var/lib/bz-get/acceptance

# Run metadata copied into RESULT.md.
ACCEPTANCE_CHANGE_ID=
ACCEPTANCE_OPERATOR=
ACCEPTANCE_SITE=stage4-stand
