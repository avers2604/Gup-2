# Infrastructure/bootstrap secret set.
# Keep this OUT of the Django web/worker environment. In production inject
# values from the infrastructure secret manager; for local compose copy to
# deploy/infra.env and pass: docker compose --env-file deploy/infra.env ...

POSTGRES_DB=bz_get
POSTGRES_ADMIN_USER=bz_get_admin
POSTGRES_ADMIN_PASSWORD=replace-with-admin-secret
POSTGRES_MIGRATION_USER=bz_get_migrator
POSTGRES_MIGRATION_PASSWORD=replace-with-migration-secret
POSTGRES_USER=bz_get_app
POSTGRES_PASSWORD=replace-with-runtime-secret
GRAFANA_POSTGRES_USER=bz_get_grafana
GRAFANA_POSTGRES_PASSWORD=replace-with-grafana-db-secret
# For HA production migrations, point directly at the controlled writable
# primary/service endpoint; do not route migration credentials via runtime PgBouncer.
POSTGRES_MIGRATION_HOST=localhost
POSTGRES_MIGRATION_PORT=5432

MINIO_ROOT_USER=bz_get_root
MINIO_ROOT_PASSWORD=replace-with-minio-root-secret
MINIO_ACCESS_KEY=bz_get_app
MINIO_SECRET_KEY=replace-with-minio-app-secret
MINIO_BUCKET_ORIGINALS=bz-get-originals
MINIO_BUCKET_WORKING=bz-get-working

GRAFANA_ADMIN_PASSWORD=replace-with-grafana-admin-secret
